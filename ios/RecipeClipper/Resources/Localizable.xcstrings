    "pantry_empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing in the pantry yet. Type what's in your cupboards above, or add things as you tick them off the grocery list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay nada en la despensa. Escribe arriba lo que tienes en los armarios, o añade cosas al marcarlas en la lista de la compra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien dans le garde-manger pour l'instant. Saisissez ci-dessus ce qu'il y a dans vos placards, ou ajoutez des articles en les cochant sur la liste de courses."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts im Vorrat. Tippe oben ein, was in deinen Schränken ist, oder füge Dinge hinzu, wenn du sie auf der Einkaufsliste abhakst."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dispensa è ancora vuota. Scrivi qui sopra cosa c'è nei tuoi armadietti, o aggiungi le cose mentre le spunti dalla lista della spesa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada na despensa ainda. Digite acima o que tem nos seus armários, ou adicione itens ao marcá-los na lista de compras."
          }
        }
      }
    },
