<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  The app's privacy manifest. No tracking, no collected data (recipes and settings stay on
  the device). The one required-reason API is UserDefaults, for the app's own settings: in
  the App Group suite it shares with its share extension (1C8F.1), or the app's own
  defaults if that group isn't available (CA92.1). The share extension doesn't use
  UserDefaults (project.yml leaves UserDefaultsAppPreferences out of it) or any other
  required-reason API, so it has no manifest; add one there if it starts to. Xcode's privacy
  report (Organizer, an archive, Generate Privacy Report) lists what a build actually uses.
-->
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
