<?xml version="1.0" encoding="utf-8"?>
<!-- A home-screen widget with room for one row (#329): the first item, which HomeWidgets adds,
     with a bare "+3" beside it, so the widget always names something. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/widget_counted_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:textColor="@color/widget_muted"
        android:textSize="15sp" />
</LinearLayout>
