<?xml version="1.0" encoding="utf-8"?>
<!-- The Tonight home-screen widget (#309). HomeWidgets refreshes it when the plan changes, and
     every 30 minutes (the least Android allows), which carries it over midnight. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_tonight_description"
    android:initialLayout="@layout/widget_list"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="70dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
