<?xml version="1.0" encoding="utf-8"?>
<!-- The Tonight home-screen widget (#309). HomeWidgets redraws it when the plan changes, and
     WidgetDayChange's alarm at midnight: no periodic refresh (#329), which was a wake-up every
     30 minutes for one change a day. Its smallest size holds the title and one meal. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_tonight_description"
    android:initialLayout="@layout/widget_list"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="96dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
