<?xml version="1.0" encoding="utf-8"?>
<!-- The grocery list home-screen widget (#309). HomeWidgets redraws it when the list changes;
     nothing else moves it, so there is no periodic refresh (#329). Its smallest size holds the
     title and one line. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_groceries_description"
    android:initialLayout="@layout/widget_list"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="80dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
