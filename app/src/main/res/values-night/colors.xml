    <!-- The app's accent for notifications, on ink (AccentTextOnInk). -->
    <color name="accent">#7ED39C</color>
    <!-- The home-screen widgets (#309): the theme's tokens, on-ink at night. -->
    <color name="widget_ground">#0E1310</color>
    <color name="widget_ink">#EDF3EE</color>
    <color name="widget_muted">#9BA89F</color>
    <color name="widget_accent">#7ED39C</color>
</resources>
