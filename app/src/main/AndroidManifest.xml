<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Connectivity: telling "offline" from other failures, and reloading on reconnect. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Step timers (#10) and pantry expiry reminders (#52): the notification, an exact alarm for it where the user
         allows exact alarms (else an inexact one), and rescheduling after a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".RecipeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.RecipeClipper"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.RecipeClipper">

            <!-- Lets the app be launched normally from the home screen -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- This is what makes it show up in the Android share sheet
                 when you share a link from Chrome or any other app -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- "Scan a recipe" (#226): a photo or screenshot of a recipe, or several pages,
                 shared in from the gallery or another app, read on the device -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- A Recipe Clipper file (#149): recipes and grocery items sent from another phone,
                 opened from a message or a file manager, or shared in. By its own type... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.recipeclipper+json" />
            </intent-filter>
            <!-- ...or by its name, for apps that hand it over as a generic file. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.recipeclipper" />
                <data android:pathPattern=".*\\..*\\.recipeclipper" />
                <data android:pathPattern=".*\\..*\\..*\\.recipeclipper" />
            </intent-filter>
        </activity>

        <!-- Shares an export file (Settings → Export recipes) with the app the user picks.
             Only cache/exports/ is exposed, and only to the target of that one share. A file sent
             to someone else (#149) goes out as its own type, so their phone opens it in the app. -->
        <provider
            android:name=".ui.sharefile.ShareFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Asks Play services to download the text recognition model (#198) when the app is
             installed, so "Read the photo" usually works on first use, offline included. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <receiver
            android:name=".timers.TimerAlarmReceiver"
            android:exported="false" />

        <!-- The pantry's morning expiry reminder (#52). -->
        <receiver
            android:name=".reminders.ExpiryReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".timers.TimerBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
